#!/usr/bin/env python3
"""OpenRouter credit collector for the Agents Monitor panel.

Prints (or, with --write, atomically writes) the record contract that
~/.local/state/omarchy/agents/usage/ consumers expect — the same contract
the stock omarchy-agent-usage-claude/codex/fireworks collectors and the
bundled pi/opencode collectors emit.

OpenRouter has no subscription windows to meter — it is pay-as-you-go
credit, so the record carries a single "Credits used" limit row (no reset:
credits do not renew) and a balance line instead of session history:

  GET /api/v1/credits            → total_credits, total_usage
  GET /api/v1/auth/key           → label, usage_daily, is_free_tier

Balance is total_credits − total_usage (there is no `remaining` field).

Key resolution: $OPENROUTER_API_KEY, else {"apiKey": …} in
~/.config/omarchy/agents/openrouter.json (the fireworks.json precedent —
systemd user units do not inherit the shell environment). Without a key
the record is printed not-ready with help text and nothing is written, so
a previously collected record is never clobbered by an unconfigured run.

Token stats (today, tokens-by-day, tokens-by-model) come from the
Analytics API - POST /api/v1/analytics/query, which needs a MANAGEMENT
key (Settings -> Management Keys; read-only, cannot make model requests).
Optional "managementKey" in the same config file (or
$OPENROUTER_MANAGEMENT_KEY). Without it the record degrades to the
balance-only shape: credits meters work, token sections stay empty.
Metric names are discovered from /api/v1/analytics/meta each run so an
upstream rename degrades a metric, not the whole collector.

Stats are account-scoped (scope "account", hasLocalStats false, the
fireworks convention): they replicate the same upstream truth on every
synced device, so the sync merge must take the max, not the sum.
"""

import json
import os
import sys
import tempfile
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

USAGE_DIR = Path(
    os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")
) / "omarchy" / "agents" / "usage"

CREDITS_URL = "https://openrouter.ai/api/v1/credits"
KEY_URL = "https://openrouter.ai/api/v1/auth/key"
ANALYTICS_QUERY_URL = "https://openrouter.ai/api/v1/analytics/query"
ANALYTICS_META_URL = "https://openrouter.ai/api/v1/analytics/meta"
OPENROUTER_CONFIG = Path.home() / ".config" / "omarchy" / "agents" / "openrouter.json"
TIMEOUT = 10.0
ANALYTICS_WINDOW_DAYS = 7

# Candidate analytics metrics mapped onto the record's Claude-shaped token
# buckets. Rows simply omit metrics the account never used or that upstream
# renamed; every read is a .get() with a default.
METRIC_INPUT = "tokens_prompt"
METRIC_OUTPUT = "tokens_completion"
METRIC_REASONING = "tokens_reasoning"
METRIC_CACHE_READ = "tokens_cache_read"
METRIC_REQUESTS = "request_count"

AUTH_HELP = (
    "Set OPENROUTER_API_KEY, or put {\"apiKey\": …} in "
    + str(OPENROUTER_CONFIG)
)


def api_key():
    """$OPENROUTER_API_KEY, else the config file; \"\" when unconfigured."""
    env = os.environ.get("OPENROUTER_API_KEY")
    if env:
        return env
    return config_value("apiKey")


def config_value(name):
    if OPENROUTER_CONFIG.is_file():
        try:
            value = json.loads(OPENROUTER_CONFIG.read_text(encoding="utf-8")).get(name)
        except (OSError, json.JSONDecodeError):
            return ""
        if value:
            return str(value)
    return ""


def management_key():
    """$OPENROUTER_MANAGEMENT_KEY, else the config file; "" when absent.
    Analytics (token stats) needs it; the balance works without."""
    env = os.environ.get("OPENROUTER_MANAGEMENT_KEY")
    if env:
        return env
    return config_value("managementKey")


def fetch_json(url, key):
    request = urllib.request.Request(
        url,
        headers={"Authorization": "Bearer " + key, "Accept": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return json.loads(response.read().decode("utf-8")).get("data") or {}


def money(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def number(value):
    try:
        n = float(value)
    except (TypeError, ValueError):
        return 0
    return int(n) if n > 0 else 0


# ---------------------------------------------------------------- analytics


def analytics_metrics(meta_payload):
    """Metric list for the query. /meta is the source of truth when
    readable: candidates missing from meta (renamed upstream, or metrics
    an account never used) are dropped; a meta failure sends the
    candidates as-is and fetch_analytics falls back to request_count
    only on a 400."""
    candidates = [
        METRIC_REQUESTS, METRIC_INPUT, METRIC_OUTPUT,
        METRIC_REASONING, METRIC_CACHE_READ,
    ]
    try:
        known = set()
        for metric in (meta_payload.get("data") or {}).get("metrics") or []:
            name = metric.get("name") if isinstance(metric, dict) else metric
            if name:
                known.add(str(name))
        if known:
            return [m for m in candidates if m in known] or [METRIC_REQUESTS]
    except (AttributeError, TypeError):
        pass
    return candidates


def query_analytics(key, metrics, start, end):
    body = json.dumps({
        "metrics": metrics,
        "dimensions": ["model"],
        "granularity": "day",
        "time_range": {"start": start, "end": end},
        "limit": 1000,
    }).encode("utf-8")
    request = urllib.request.Request(
        ANALYTICS_QUERY_URL,
        data=body,
        headers={
            "Authorization": "Bearer " + key,
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return json.loads(response.read().decode("utf-8"))


def fetch_analytics(key, now):
    """Rows for the last ANALYTICS_WINDOW_DAYS days grouped by day+model,
    or None on any failure. Never raises. OpenRouter buckets days in UTC;
    the panel's Today is local - the boundary hour can differ, the same
    compromise every remote-stats collector makes."""
    start = (now - timedelta(days=ANALYTICS_WINDOW_DAYS)).strftime("%Y-%m-%dT%H:%M:%SZ")
    end = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    metrics = None
    try:
        try:
            meta = fetch_json(ANALYTICS_META_URL, key)
        except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
            meta = {}
        metrics = analytics_metrics(meta)
        payload = query_analytics(key, metrics, start, end)
        rows = payload.get("data") or {}
        if isinstance(rows, dict):
            rows = rows.get("data")
        if isinstance(rows, list):
            return rows
    except urllib.error.HTTPError as error:
        if error.code in (400, 422) and metrics and metrics != [METRIC_REQUESTS]:
            # A renamed metric upstream: degrade to requests only.
            try:
                payload = query_analytics(key, [METRIC_REQUESTS], start, end)
                rows = (payload.get("data") or {}).get("data")
                if isinstance(rows, list):
                    return rows
            except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
                pass
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
        pass
    return None


def apply_analytics(record, rows, recent_dates):
    """Fold analytics rows into the record's token sections. Never raises;
    unusable input leaves the balance-only zeros in place."""
    if not rows:
        return
    recent = {d: 0 for d in recent_dates}
    models = {}
    today = str(record.get("updatedAt") or "")[:10]  # UTC date, the API's clock
    today_tokens = 0
    today_prompts = 0
    active = set()
    for row in rows:
        if not isinstance(row, dict):
            continue
        day = str(row.get("date__day") or "")[:10]
        if day not in recent:
            continue  # outside the window (bad row or upstream drift)
        model = str(row.get("model") or "") or "unknown"
        input_t = number(row.get(METRIC_INPUT))
        output_t = number(row.get(METRIC_OUTPUT)) + number(row.get(METRIC_REASONING))
        cache_t = number(row.get(METRIC_CACHE_READ))
        requests = number(row.get(METRIC_REQUESTS))
        total = input_t + output_t + cache_t
        if not (total or requests):
            continue
        active.add(day)
        if day in recent:
            recent[day] += total
        bucket = models.setdefault(model, {
            "inputTokens": 0,
            "outputTokens": 0,
            "cacheReadInputTokens": 0,
            "cacheCreationInputTokens": 0,
        })
        bucket["inputTokens"] += input_t
        bucket["outputTokens"] += output_t
        bucket["cacheReadInputTokens"] += cache_t
        if day == today:
            today_tokens += total
            today_prompts += requests
    record["recentDays"] = [{"date": d, "messageCount": recent[d]} for d in recent_dates]
    record["modelUsage"] = models
    record["todayTotalTokens"] = today_tokens
    record["todayPrompts"] = today_prompts
    record["activeDays"] = len(active)
    record["activeDates"] = sorted(active)


def scan():
    now = datetime.now(timezone.utc)
    today = now.strftime("%Y-%m-%d")
    recent_dates = []
    for offset in range(6, -1, -1):
        recent_dates.append(
            (now - timedelta(days=offset)).strftime("%Y-%m-%d")
        )

    record = {
        "schemaVersion": 1,
        "id": "openrouter",
        "name": "OpenRouter",
        "updatedAt": now.isoformat(),
        "ready": False,
        "hasLocalStats": False,
        "scope": "account",
        "tierLabel": "Pay-as-you-go",
        "limits": [],
        "usageStatusText": "",
        "authHelpText": "",
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [{"date": d, "messageCount": 0} for d in recent_dates],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
    }

    key = api_key()
    if not key:
        record["authHelpText"] = AUTH_HELP
        return record

    try:
        credits = fetch_json(CREDITS_URL, key)
        total = money(credits.get("total_credits"))
        used = money(credits.get("total_usage"))
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
        record["authHelpText"] = "OpenRouter is unreachable right now"
        return record
    if total is None or used is None:
        record["authHelpText"] = "OpenRouter returned an invalid credits response"
        return record

    try:
        keyinfo = fetch_json(KEY_URL, key)
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
        keyinfo = {}

    record["ready"] = True
    mkey = management_key()
    if mkey:
        apply_analytics(record, fetch_analytics(mkey, now), recent_dates)
    balance = total - used
    if total > 0:
        record["limits"] = [{
            "label": "Credits used",
            "title": "Credits used",
            "percent": min(1.0, used / total),
            "resetsAt": "",  # credits do not renew; no countdown
        }]
    status = f"${balance:.2f} of ${total:.2f} left"
    daily = money(keyinfo.get("usage_daily"))
    if daily and daily > 0:
        status += f" · today ${daily:.2f}"
    record["usageStatusText"] = status
    if keyinfo.get("is_free_tier"):
        record["tierLabel"] = "Free tier"
    return record


def write_record(record):
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(USAGE_DIR), prefix=".openrouter.", text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(record, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, str(USAGE_DIR / "openrouter.json"))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main():
    record = scan()
    if "--write" in sys.argv[1:]:
        if not record["ready"]:
            # Never clobber a previously collected good record with an
            # unconfigured or failed run.
            sys.stderr.write(f"skipped: {record['authHelpText']}\n")
            return
        write_record(record)
        print(f"wrote {USAGE_DIR / 'openrouter.json'}")
    else:
        json.dump(record, sys.stdout, indent=2)
        sys.stdout.write("\n")


if __name__ == "__main__":
    main()
