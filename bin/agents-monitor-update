#!/usr/bin/env bash
# Agents Monitor refresh runner.
#
# Called by the panel with the same arguments the stock widget would pass to
# omarchy-agent-usage-update (--force, --limits-only, --except <id>, and/or a
# list of agent ids). Forwards them to the stock updater (claude, codex,
# fireworks) and runs every bundled collector under the same rules, so all
# enabled providers refresh together on the panel's timer and refresh
# button.
#
# Bundled collectors are discovered by filename convention: anything
# shipped as omarchy-agent-usage-<id> (executable, regular file) runs with
# <id> as its provider id — a new collector is a dropped file, and this
# list never needs editing. The discovery layer
# (omarchy-agent-usage-discover) rides the same slot.
#
# The external omarchy-pi-usage.timer (option 2) keeps refreshing pi.json
# between panel refreshes; it is redundant by design, not by accident.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

flags=()
only=()
declare -A excluded

while [[ $# -gt 0 ]]; do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

# Stock collectors: claude, codex, fireworks.
omarchy-agent-usage-update ${flags[@]+"${flags[@]}"} ${only[@]+"${only[@]}"} \
  $(for id in "${!excluded[@]}"; do printf -- '--except %q ' "$id"; done) || true
# Bundled local collectors, by filename convention (see header): same
# inclusion rules as the stock updater applies to its agents.
shopt -s nullglob
for collector in "$script_dir"/omarchy-agent-usage-*; do
  # A stray backup or editor temp file in bin/ is not a collector; only an
  # executable regular file whose name the convention owns gets to run.
  [[ -f $collector && -x $collector ]] || continue
  agent=${collector##*/}
  agent=${agent#omarchy-agent-usage-}
  [[ -n $agent ]] || continue
  run=1
  if [[ -n ${excluded[$agent]:-} ]]; then
    run=0
  elif (( ${#only[@]} > 0 )); then
    run=0
    for id in "${only[@]}"; do
      [[ $id == "$agent" ]] && run=1
    done
  fi

  if (( run )) && [[ " ${flags[*]:-} " != *" --limits-only "* ]]; then
    "$collector" --write >/dev/null || true
  fi
done
shopt -u nullglob

# Configuration state is machine truth, not probe output: stamp it after
# every pass regardless of --except/only filters (an excluded provider's
# configured-ness did not change because this pass skipped its probe).
# Covers the stock records (upstream writes no such field) and openrouter
# (whose collector writes nothing when keyless, so a removed key would
# otherwise leave a stale record). zai stamps itself: it also runs from
# its own systemd timer, outside this runner.
"$script_dir/agents-monitor-config-check" || true
