#!/usr/bin/env bash
# Agents Monitor refresh runner.
#
# Called by the panel with the same arguments the stock widget would pass to
# omarchy-agent-usage-update (--force, --limits-only, --except <id>, and/or a
# list of agent ids). Forwards them to the stock updater (claude, codex,
# fireworks) and runs the bundled pi and opencode collectors under the same
# rules, so all enabled providers refresh together on the panel's timer and
# refresh button.
#
# The external omarchy-pi-usage.timer (option 2) keeps refreshing pi.json
# between panel refreshes; it is redundant by design, not by accident.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

flags=()
only=()
declare -A excluded

while [[ $# -gt 0 ]]; do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

# Stock collectors: claude, codex, fireworks.
omarchy-agent-usage-update ${flags[@]+"${flags[@]}"} ${only[@]+"${only[@]}"} \
  $(for id in "${!excluded[@]}"; do printf -- '--except %q ' "$id"; done) || true

# Bundled local collectors (pi, opencode, openrouter, hermes) plus the
# discovery layer (catalog -> installed -> used -> MVP records): same
# inclusion rules as the stock updater applies to its agents.
for agent in pi opencode openrouter hermes discover; do
  run=1
  if [[ -n ${excluded[$agent]:-} ]]; then
    run=0
  elif (( ${#only[@]} > 0 )); then
    run=0
    for id in "${only[@]}"; do
      [[ $id == "$agent" ]] && run=1
    done
  fi

  if (( run )) && [[ " ${flags[*]:-} " != *" --limits-only "* ]]; then
    "$script_dir/omarchy-agent-usage-$agent" --write >/dev/null || true
  fi
done
