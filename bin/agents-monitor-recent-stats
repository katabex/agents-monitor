#!/usr/bin/env python3
"""Stamp 7-day model/subscription breakdowns into the stock records.

The agent card's TOKENS BY MODEL and PER SUBSCRIPTION sections are scoped
to the last 7 days (user decision 2026-09-18). Bundled collectors (pi,
opencode, hermes) write `recentModelUsage` / `recentSubscriptionUsage`
themselves; the stock claude/codex collectors do not know the fields, so
this pass recomputes them from the very stores those collectors read -
mirroring their message extraction line for line (same files, same token
mapping, same dedupe) and keeping only entries whose local day falls in
the recentDays window (today-6 .. today). The all-time fields the stock
collector writes are left untouched.

claude  ~/.claude/projects/**/*.jsonl assistant entries, plus pi/omp
        session files and opencode's db rows that ran on the anthropic
        provider - a pi session burns the Claude subscription without
        ever writing a native Claude Code transcript, and the stock
        claude collector's scan_pi_usage()/scan_opencode_usage() merge
        exactly that into its all-time stats, so the 7-day mirror must
        cover the same three sources or it undercounts (caught live
        2026-09-18: this very session runs pi on the anthropic
        provider, and the first cut of this script only scanned
        ~/.claude/projects - the cross-check below is what caught it).
codex   ~/.codex/{sessions,archived_sessions} rollouts (token_count),
        plus pi/omp session files and opencode's db rows that ran on
        openai-codex/openai - the stock codex collector counts those
        subscriptions wherever they were burned, so the 7-day mirror
        must too.

Cross-check built in: the stamped buckets must sum to the record's own
recentDays token total (same window, same sources); a mismatch is
printed to stderr and still stamps (the day buckets stay authoritative
for admission, the split for display).

Claude/codex burn exactly one subscription each by definition, so only
`recentModelUsage` is stamped - the panel synthesizes their recent PER
SUBSCRIPTION attribution from it, the same way it synthesizes the
all-time side from `modelUsage`.

Usage: agents-monitor-recent-stats [id ...]   (claude codex; default both)
"""

import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

USAGE_DIR = Path(
    os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")
) / "omarchy" / "agents" / "usage"

FIELDS = ("inputTokens", "outputTokens", "cacheReadInputTokens", "cacheCreationInputTokens")


def empty_bucket():
    return {field: 0 for field in FIELDS}


def add_tokens(bucket, input_t, output_t, read_t, write_t):
    bucket["inputTokens"] += input_t
    bucket["outputTokens"] += output_t
    bucket["cacheReadInputTokens"] += read_t
    bucket["cacheCreationInputTokens"] += write_t


def bucket_total(usage):
    return sum(number(usage.get(field)) for field in FIELDS)


def number(value):
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except (TypeError, ValueError):
        return 0


def recent_dates():
    today = datetime.now().toordinal()
    return {
        datetime.fromordinal(today - offset).strftime("%Y-%m-%d")
        for offset in range(0, 7)
    }


def local_day(value):
    """Local calendar date for a timestamp field; '' when unparseable."""
    if value is None:
        return ""
    if isinstance(value, (int, float)):
        ts = float(value)
        if ts > 10_000_000_000:  # milliseconds (pi) vs seconds (codex)
            ts = ts / 1000
        try:
            return datetime.fromtimestamp(ts).strftime("%Y-%m-%d")
        except (OSError, ValueError):
            return ""
    text = str(value)
    try:
        if text.endswith("Z"):
            parsed = datetime.fromisoformat(text[:-1] + "+00:00")
        else:
            parsed = datetime.fromisoformat(text)
        if parsed.tzinfo is not None:
            parsed = parsed.astimezone()
        return parsed.strftime("%Y-%m-%d")
    except ValueError:
        return ""


def json_lines(path):
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                # Cheap pre-filter before JSON parsing (stock discipline).
                yield line
    except OSError:
        return


# ---------------------------------------------------------------- claude


def scan_claude_projects(window):
    """Native Claude Code CLI transcripts under ~/.claude/projects."""
    config_dir = Path(
        os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
    ).expanduser()
    projects = config_dir / "projects"
    by_model = {}
    seen = set()
    if not projects.is_dir():
        return by_model

    for path in projects.rglob("*.jsonl"):
        for line_number, line in enumerate(json_lines(path), 1):
            if '"usage":' not in line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
            if entry.get("type") != "assistant" and message.get("role") != "assistant":
                continue
            usage = message.get("usage") or entry.get("usage")
            if not isinstance(usage, dict):
                continue
            message_id = message.get("id") or entry.get("messageId") or ""
            unique_key = str(message_id) if message_id else (
                f"{path}:{entry.get('uuid') or entry.get('requestId') or line_number}")
            if unique_key in seen:
                continue
            seen.add(unique_key)

            def token(snake, camel):
                return number(usage.get(snake, usage.get(camel, 0)))

            input_t = token("input_tokens", "inputTokens")
            output_t = token("output_tokens", "outputTokens")
            read_t = token("cache_read_input_tokens", "cacheReadInputTokens")
            write_t = token("cache_creation_input_tokens", "cacheCreationInputTokens")
            if not (input_t or output_t or read_t or write_t):
                continue
            day = local_day(entry.get("timestamp") or message.get("timestamp"))
            if day not in window:
                continue
            model = str(message.get("model") or entry.get("model") or "claude")
            add_tokens(by_model.setdefault(model, empty_bucket()),
                       input_t, output_t, read_t, write_t)
    return by_model


def scan_claude_pi(window):
    """pi/omp session messages that ran on the anthropic provider - the
    stock collector's scan_pi_usage() merges these into claude.json's
    all-time stats (a pi session burns the Claude subscription without
    ever writing a native Claude Code transcript). Same pre-filter, same
    provider match, same dedupe key, same usage-key precedence."""
    by_model = {}
    seen = set()
    for root in (Path.home() / ".pi" / "agent" / "sessions",
                 Path.home() / ".omp" / "agent" / "sessions"):
        if not root.is_dir():
            continue
        for path in root.rglob("*.jsonl"):
            for line_number, line in enumerate(json_lines(path), 1):
                if '"usage"' not in line or '"assistant"' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
                if entry.get("type") != "message" or message.get("role") != "assistant":
                    continue
                if str(message.get("provider") or "") != "anthropic":
                    continue
                unique_key = f"{path}:{entry.get('id') or line_number}"
                if unique_key in seen:
                    continue
                seen.add(unique_key)
                usage = message.get("usage") or {}

                def token(snake, camel):
                    return number(usage.get(snake, usage.get(camel, 0)))

                input_t = token("input", "inputTokens")
                output_t = token("output", "outputTokens")
                read_t = token("cacheRead", "cache_read_input_tokens")
                write_t = token("cacheWrite", "cache_creation_input_tokens")
                total = input_t + output_t + read_t + write_t
                if total <= 0:
                    total = number(usage.get("totalTokens"))
                    input_t = total
                if total <= 0:
                    continue
                day = local_day(entry.get("timestamp") or message.get("timestamp"))
                if day not in window:
                    continue
                model = str(message.get("model") or "claude")
                add_tokens(by_model.setdefault(model, empty_bucket()),
                           input_t, output_t, read_t, write_t)
    return by_model


def scan_claude_opencode(window):
    """opencode db rows that ran on provider anthropic - the stock
    collector's scan_opencode_usage() merges these the same way."""
    today = datetime.now().strftime("%Y-%m-%d")
    db = Path(
        os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    ).expanduser() / "opencode" / "opencode.db"
    by_model = {}
    if not db.is_file():
        return by_model
    try:
        conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    except sqlite3.Error:
        return by_model
    try:
        conn.execute("PRAGMA query_only = ON")
        for _session_id, raw in conn.execute("SELECT session_id, data FROM message"):
            try:
                entry = json.loads(raw)
                if not isinstance(entry, dict) or entry.get("role") != "assistant":
                    continue
                if str(entry.get("providerID") or "") != "anthropic":
                    continue
                tokens = entry.get("tokens") or {}
                cache = tokens.get("cache") or {}
                input_t = number(tokens.get("input"))
                output_t = number(tokens.get("output")) + number(tokens.get("reasoning"))
                read_t = number(cache.get("read"))
                write_t = number(cache.get("write"))
                if not (input_t or output_t or read_t or write_t):
                    continue
                created = number((entry.get("time") or {}).get("created"))
                # Stock falls back to today when the message carries no
                # timestamp, same as here.
                day = local_day(created / 1000) if created > 0 else today
                if day not in window:
                    continue
                model = str(entry.get("modelID") or "claude").rstrip("/").split("/")[-1]
            except Exception:
                continue
            add_tokens(by_model.setdefault(model, empty_bucket()),
                       input_t, output_t, read_t, write_t)
    except sqlite3.Error:
        pass
    finally:
        conn.close()
    return by_model


def scan_claude(window):
    by_model = scan_claude_projects(window)
    for source in (scan_claude_pi(window), scan_claude_opencode(window)):
        for model, bucket in source.items():
            target = by_model.setdefault(model, empty_bucket())
            for field in FIELDS:
                target[field] += bucket[field]
    return by_model


# ----------------------------------------------------------------- codex


def codex_model_name(raw):
    value = str(raw or "codex")
    # The stock collector lowercases and keeps hyphenated ids as-is; mirror
    # just the segment cleanup so names match the all-time modelUsage keys.
    return value


def scan_codex_native(window):
    codex_home = Path(
        os.environ.get("CODEX_HOME") or str(Path.home() / ".codex")
    ).expanduser()
    by_model = {}
    cutoff = time.time() - 30 * 24 * 60 * 60
    for root_name in ("sessions", "archived_sessions"):
        root = codex_home / root_name
        if not root.is_dir():
            continue
        for path in root.rglob("*.jsonl"):
            try:
                if path.stat().st_mtime < cutoff:
                    continue
            except OSError:
                continue
            current_model = "codex"
            for line in json_lines(path):
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if entry.get("type") == "turn_context":
                    payload = entry.get("payload") or {}
                    current_model = codex_model_name(
                        payload.get("model") or payload.get("model_slug") or current_model)
                    continue
                payload = entry.get("payload") or entry
                if entry.get("type") == "response_item" and isinstance(payload, dict):
                    payload = payload.get("payload") or payload
                if not isinstance(payload, dict) or payload.get("type") != "token_count":
                    continue
                info = payload.get("info") or {}
                usage = info.get("last_token_usage") or {}
                read_t = number(usage.get("cached_input_tokens"))
                write_t = number(usage.get("cache_write_input_tokens"))
                input_t = max(0, number(usage.get("input_tokens")) - read_t - write_t)
                output_t = number(usage.get("output_tokens"))
                if not (input_t or output_t or read_t or write_t):
                    continue
                day = local_day(entry.get("timestamp"))
                if not day:
                    try:
                        day = datetime.fromtimestamp(path.stat().st_mtime).strftime("%Y-%m-%d")
                    except OSError:
                        day = ""
                if day not in window:
                    continue
                add_tokens(by_model.setdefault(current_model, empty_bucket()),
                           input_t, output_t, read_t, write_t)
    return by_model


def scan_codex_pi(window):
    """pi/omp session messages that ran on openai-codex (stock mirrors this)."""
    by_model = {}
    seen = set()
    for root in (Path.home() / ".pi" / "agent" / "sessions",
                 Path.home() / ".omp" / "agent" / "sessions"):
        if not root.is_dir():
            continue
        try:
            proc = subprocess.Popen(
                ["rg", "--json",
                 "-e", r'"provider"\s*:\s*"openai-codex"',
                 "-e", r'"api"\s*:\s*"openai-codex',
                 str(root)],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                text=True, errors="replace",
            )
        except FileNotFoundError:
            continue
        assert proc.stdout is not None
        for raw in proc.stdout:
            try:
                event = json.loads(raw)
                if event.get("type") != "match":
                    continue
                line = event.get("data", {}).get("lines", {}).get("text", "")
                path = event.get("data", {}).get("path", {}).get("text", "pi-session")
                entry = json.loads(line)
            except Exception:
                continue
            if entry.get("type") != "message":
                continue
            message_key = path + ":" + str(entry.get("id") or "")
            if message_key in seen:
                continue
            seen.add(message_key)
            message = entry.get("message") or {}
            if message.get("role") != "assistant":
                continue
            provider = str(message.get("provider") or "")
            api = str(message.get("api") or "")
            if provider != "openai-codex" and not api.startswith("openai-codex"):
                continue
            usage = message.get("usage") or {}
            if not usage:
                continue
            total = number(usage.get("totalTokens"))
            input_t = number(usage.get("input"))
            output_t = number(usage.get("output"))
            read_t = number(usage.get("cacheRead"))
            write_t = number(usage.get("cacheWrite"))
            if total and not (input_t or output_t or read_t or write_t):
                input_t = total
            if not (input_t or output_t or read_t or write_t):
                continue
            day = local_day(entry.get("timestamp") or message.get("timestamp"))
            if day not in window:
                continue
            add_tokens(by_model.setdefault(codex_model_name(message.get("model")), empty_bucket()),
                       input_t, output_t, read_t, write_t)
        try:
            proc.wait(timeout=1)
        except Exception:
            proc.kill()
    return by_model


def scan_codex_opencode(window):
    """opencode db rows that ran on provider openai (stock mirrors this)."""
    db = Path(
        os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    ).expanduser() / "opencode" / "opencode.db"
    by_model = {}
    if not db.is_file():
        return by_model
    try:
        conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    except sqlite3.Error:
        return by_model
    try:
        conn.execute("PRAGMA query_only = ON")
        for _session_id, raw in conn.execute(
            "SELECT session_id, data FROM message"
            " WHERE data LIKE '%\"role\"%:%\"assistant\"%'"
            " AND data LIKE '%\"providerID\"%:%\"openai\"%'"
            " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.role') END = 'assistant'"
            " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.providerID') END = 'openai'"
        ):
            try:
                entry = json.loads(raw)
                if not isinstance(entry, dict) or entry.get("role") != "assistant":
                    continue
                if str(entry.get("providerID") or "") != "openai":
                    continue
                tokens = entry.get("tokens") or {}
                cache = tokens.get("cache") or {}
                input_t = number(tokens.get("input"))
                output_t = number(tokens.get("output")) + number(tokens.get("reasoning"))
                read_t = number(cache.get("read"))
                write_t = number(cache.get("write"))
                if not (input_t or output_t or read_t or write_t):
                    continue
                day = local_day((entry.get("time") or {}).get("created"))
                if day not in window:
                    continue
                model = codex_model_name(str(entry.get("modelID") or "").rstrip("/").split("/")[-1])
            except Exception:
                continue
            add_tokens(by_model.setdefault(model, empty_bucket()),
                       input_t, output_t, read_t, write_t)
    except sqlite3.Error:
        pass
    finally:
        conn.close()
    return by_model


def scan_codex(window):
    by_model = scan_codex_native(window)
    for source in (scan_codex_pi(window), scan_codex_opencode(window)):
        for model, bucket in source.items():
            target = by_model.setdefault(model, empty_bucket())
            for field in FIELDS:
                target[field] += bucket[field]
    return by_model


SCANS = {"claude": scan_claude, "codex": scan_codex}


def merge_into(bucket_map, window_total):
    total = 0
    for bucket in bucket_map.values():
        total += bucket_total(bucket)
    return total


def main(argv):
    ids = [arg for arg in argv[1:] if arg in SCANS] or list(SCANS)
    window = recent_dates()
    for agent_id in ids:
        path = USAGE_DIR / (agent_id + ".json")
        try:
            record = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue  # nothing collected yet: absent record, absent sections
        by_model = {model: bucket for model, bucket in SCANS[agent_id](window).items()
                    if bucket_total(bucket) > 0}
        record["recentModelUsage"] = by_model
        stamped = merge_into(by_model, None)
        day_total = sum(number(day.get("messageCount")) for day in record.get("recentDays") or [])
        if stamped != day_total:
            print(
                f"agents-monitor-recent-stats: {agent_id} 7d model split {stamped}"
                f" != recentDays {day_total} (stale record or mirror drift)",
                file=sys.stderr,
            )
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(record, separators=(",", ":")), encoding="utf-8")
        os.replace(tmp, path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
