#!/usr/bin/env python3
"""Live agent sessions for the Agents Monitor panel.

Two modes, two output files (spec: docs/superpowers/specs/2026-09-06-live-agents-design.md):

  --quick (default)  directory listings + file stats + head/tail peeks only.
                     Writes live.json. Driven every 15 s by the bar widget's
                     QML probe, so the badge feels live.
  --full             everything quick does, plus whole-file parsing for
                     per-project token totals. Also writes projects.json.
                     Driven by the 5-minute systemd timer and the panel
                     refresh runner.

Providers with local session logs: pi, Claude Code, Codex. Fireworks has no
local sessions (billing API only) and is deliberately absent.

The producer never stamps session state: active/idle is derived by the
consumer from lastActivity against the clock, so stale data degrades instead
of lying. Every per-file failure degrades to a missing field or a skipped
row (counted in parseErrors) — never a crash.
"""

import argparse
import json
import os
import re
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

ACTIVE_WINDOW_FILES_CAP = 200
HEAD_BYTES = 65536
TAIL_BYTES = 65536

TIMESTAMP_RE = re.compile(r'"timestamp"\s*:\s*"(\d{4}-\d{2}-\d{2}T[^"]+)"')
CWD_RE = re.compile(r'"cwd"\s*:\s*"([^"]*)"')
MODEL_RE = re.compile(r'"model"\s*:\s*"([^"]+)"')

# Display-only approximations; a codex token_count event that reports its own
# window overrides the table for that session. Unknown models get null and the
# UI shows raw tokens without a percentage.
CONTEXT_WINDOWS = [
    ("claude-sonnet-4-5-20250929-1m", 1000000),
    ("claude-sonnet-4-20250514-1m", 1000000),
    ("glm-5", 200000),
    ("glm-4.6", 200000),
    ("glm-4.5", 200000),
    ("glm-4", 128000),
    ("claude-", 200000),
    ("gpt-5.1", 400000),
    ("gpt-5", 272000),
]


def context_window_for(model, override=None):
    if override and override > 0:
        return override
    name = str(model or "")
    for prefix, window in CONTEXT_WINDOWS:
        if name.startswith(prefix):
            return window
    return None


def local_date(ts):
    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d")


def local_day_of(value):
    """Local calendar date for an ISO timestamp string or epoch seconds;
    None when unparseable (the caller treats that as not-today)."""
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return local_date(value)
    text = str(value)
    try:
        if text.endswith("Z"):
            dt = datetime.fromisoformat(text[:-1] + "+00:00")
        else:
            dt = datetime.fromisoformat(text)
    except ValueError:
        return None
    if dt.tzinfo is not None:
        dt = dt.astimezone()
    return dt.strftime("%Y-%m-%d")


def iso_utc(ts):
    return datetime.fromtimestamp(ts, timezone.utc).isoformat()


def iso_mtime(path):
    try:
        return iso_utc(path.stat().st_mtime)
    except OSError:
        return None


def read_head_tail(path):
    """First and last HEAD/TAIL_BYTES of the file, decoded leniently."""
    try:
        size = path.stat().st_size
        with open(path, "rb") as fh:
            head = fh.read(HEAD_BYTES)
            fh.seek(max(0, size - TAIL_BYTES))
            tail = fh.read(TAIL_BYTES)
        return head.decode("utf-8", "replace"), tail.decode("utf-8", "replace")
    except OSError:
        return "", ""


def first_json_lines(text):
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            parsed = json.loads(line)
        except json.JSONDecodeError:
            continue  # truncated line (session being written right now)
        if isinstance(parsed, dict):
            yield parsed


def decode_dir_path(name, sep):
    """pi ('--home-ptr-X--') and claude ('-home-ptr-X') mangle cwd into the
    directory name with `sep` for '/'. Dashes inside real names survive in
    pi (double dash) but not in claude (single dash) — best effort either way."""
    stripped = name[len(sep):] if name.startswith(sep) else name
    stripped = stripped[:-len(sep)] if stripped.endswith(sep) else stripped
    if not stripped:
        return None
    return "/" + stripped.replace(sep, "/")


def project_display(path, home):
    if not path:
        return None
    if home and (path == home or path == home.rstrip("/")):
        return "~"
    if home and path.startswith(home + "/"):
        path = "~" + path[len(home):]
    parts = [p for p in path.split("/") if p]
    if not parts:
        return "/"
    if len(parts) == 1:
        return parts[0]
    return "/".join(parts[-2:])


# ------------------------------------------------------------------ discovery

def discover_pi(root, home):
    base = root / ".pi" / "agent" / "sessions"
    alt = root / ".omp" / "agent" / "sessions"
    for directory in (base, alt):
        if directory.is_dir():
            for path in sorted(directory.rglob("*.jsonl")):
                yield path, decode_dir_path(path.parent.name, "--")


def discover_claude(root, home):
    directory = root / ".claude" / "projects"
    if not directory.is_dir():
        return
    for path in sorted(directory.rglob("*.jsonl")):
        yield path, decode_dir_path(path.parent.name, "-")


def discover_codex(root, home):
    base = root / ".codex" / "sessions"
    if not base.is_dir():
        return
    # Sessions nest by date; only today's and yesterday's local dates can
    # hold live sessions, so the scan never walks the whole history.
    dates = []
    now = datetime.now()
    for offset in (0, 1):
        dates.append((now - timedelta(days=offset)).strftime("%Y/%m/%d"))
    for date in dates:
        directory = base / date
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("rollout-*.jsonl")):
            yield path, None  # cwd comes from session_meta


DISCOVERERS = [
    ("pi", discover_pi),
    ("claude", discover_claude),
    ("codex", discover_codex),
]


def sessions_active_today(root, home):
    """[(provider, path, fallback_project)] for files touched on the local
    calendar day, capped per provider, newest first."""
    today = local_date(datetime.now().timestamp())
    found = []
    for provider, discover in DISCOVERERS:
        rows = []
        try:
            for path, fallback in discover(root, home):
                try:
                    mtime = path.stat().st_mtime
                except OSError:
                    continue
                if local_date(mtime) != today:
                    continue
                rows.append((mtime, path, fallback))
        except OSError:
            continue
        rows.sort(reverse=True)
        found.extend((provider, p, f) for _, p, f in rows[:ACTIVE_WINDOW_FILES_CAP])
    return found


# ------------------------------------------------------------- quick fields

def head_field(head, regex, group=1):
    match = regex.search(head)
    return match.group(group) if match else None


def pi_model(head):
    for entry in first_json_lines(head):
        if entry.get("type") == "model_change" and entry.get("modelId"):
            return str(entry["modelId"])
    return None


def usage_sum(blocks):
    """input + cacheRead + cacheWrite + output — the context the model held
    on its last exchange, which is what a ctx meter cares about."""
    keys = (
        ("input", "input_tokens"),
        ("cacheRead", "cache_read_input_tokens"),
        ("cacheWrite", "cache_creation_input_tokens"),
        ("output", "output_tokens"),
    )
    total = 0
    for ours, theirs in keys:
        value = blocks.get(ours)
        if value is None:
            value = blocks.get(theirs)
        try:
            total += max(0, int(float(value)))
        except (TypeError, ValueError):
            continue
    return total


def find_usage_entry(entry):
    """Locate a usage dict in one parsed jsonl line, pi or claude shape.
    pi: {"type":"message","message":{"role":"assistant","usage":{...}}}
    claude: {"type":"assistant","message":{"usage":{...}}}"""
    kind = entry.get("type")
    if kind not in ("message", "assistant"):
        return None
    message = entry.get("message")
    if not (isinstance(message, dict) and isinstance(message.get("usage"), dict)):
        return None
    if kind == "message" and message.get("role") != "assistant":
        return None
    return message["usage"]


def quick_context(head, tail, provider):
    """Context tokens from the last complete usage block in the tail."""
    lines = tail.splitlines()
    for line in reversed(lines):
        line = line.strip()
        if not line or "usage" not in line:
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if provider == "codex":
            found = codex_token_usage(entry)
            if found is not None:
                return found
            continue
        usage = find_usage_entry(entry)
        if usage is not None:
            value = usage_sum(usage)
            if value > 0:
                return value
    return None


def codex_token_usage(entry):
    """Last cumulative token_count totals; returns (tokens, window|None)."""
    if entry.get("type") != "token_count":
        return None
    info = (entry.get("payload") or {}).get("info") or {}
    totals = info.get("total_token_usage") or info.get("totalTokenUsage") or {}
    if not isinstance(totals, dict) or not totals:
        return None
    try:
        tokens = sum(
            max(0, int(float(totals.get(k, 0) or 0)))
            for k in ("input_tokens", "cached_input_tokens", "output_tokens")
        )
    except (TypeError, ValueError):
        return None
    window = info.get("model_context_window") or info.get("modelContextWindow")
    try:
        window = int(window) if window else None
    except (TypeError, ValueError):
        window = None
    return tokens, window


def quick_row(provider, path, fallback_project, home, today):
    head, tail = read_head_tail(path)
    started = head_field(head, TIMESTAMP_RE)
    cwd = head_field(head, CWD_RE)
    project = project_display(cwd or fallback_project, home)
    if provider == "pi":
        model = pi_model(head)
    else:
        model = head_field(head, MODEL_RE) or head_field(tail, MODEL_RE)
    context = quick_context(head, tail, provider)
    window_override = None
    if provider == "codex":
        for entry in first_json_lines(tail):
            found = codex_token_usage(entry)
            if found is not None:
                window_override = found[1]
                break
    mtime = iso_mtime(path)
    if mtime is None:
        return None
    # Nothing parseable anywhere: head has no JSON line and no timestamp
    # match — that is a parse error, not a mystery session.
    if started is None and not any(True for _ in first_json_lines(head)):
        return None
    return {
        "provider": provider,
        "project": project or path.stem,
        "startedAt": started or mtime,
        "lastActivity": mtime,
        "model": model,
        "approxContextTokens": context,
        "contextWindow": context_window_for(model, window_override),
    }


def scan_live(root, home):
    today = local_date(datetime.now().timestamp())
    sessions = []
    errors = {}
    for provider, path, fallback in sessions_active_today(root, home):
        try:
            row = quick_row(provider, path, fallback, home, today)
        except Exception:  # noqa: BLE001 — one bad file never kills the scan
            row = None
        if row is None:
            errors[provider] = errors.get(provider, 0) + 1
        else:
            sessions.append(row)
    sessions.sort(key=lambda s: s["lastActivity"], reverse=True)
    record = {
        "schemaVersion": 1,
        "computedAt": datetime.now(timezone.utc).isoformat(),
        "parseErrors": sum(errors.values()),
        "sessions": sessions,
    }
    return record, errors


# ------------------------------------------------------------------ full mode

def full_session_tokens(path, provider, today):
    """Token totals for the project breakdown, restricted to today's local
    calendar day. Codex rollout files are date-partitioned (one file per
    day) and report cumulative counters, so the last token_count wins
    instead of summing; pi/claude sessions can span midnight, so their
    messages are filtered by timestamp — otherwise a four-day session
    touched once today would attribute its whole life to TODAY."""
    tokens = 0
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            if provider == "codex":
                found = codex_token_usage(entry)
                if found is not None:
                    tokens = found[0]
                continue
            usage = find_usage_entry(entry)
            if usage is None:
                continue
            if local_day_of(entry.get("timestamp")) != today:
                continue
            tokens += usage_sum(usage)
    return tokens


def scan_projects(root, home, live):
    projects = {}
    by_path = {}
    today = local_date(datetime.now().timestamp())
    for provider, path, fallback in sessions_active_today(root, home):
        by_path[str(path)] = (provider, fallback)
    for path_str, (provider, fallback) in by_path.items():
        path = Path(path_str)
        row = next(
            (s for s in live["sessions"]
             if s["provider"] == provider and s["lastActivity"] == iso_mtime(path)),
            None,
        )
        project = row["project"] if row else project_display(fallback, home) or path.stem
        try:
            tokens = full_session_tokens(path, provider, today)
        except Exception:  # noqa: BLE001 — one bad file never kills the scan
            continue
        if tokens <= 0:
            continue
        bucket = projects.setdefault(project, {"project": project, "providers": {}, "total": 0})
        bucket["providers"][provider] = bucket["providers"].get(provider, 0) + tokens
        bucket["total"] += tokens
    ordered = sorted(projects.values(), key=lambda p: p["total"], reverse=True)
    return {
        "schemaVersion": 1,
        "computedAt": datetime.now(timezone.utc).isoformat(),
        "window": "today",
        "projects": ordered,
    }


# ---------------------------------------------------------------------- main

def atomic_write(directory, name, payload):
    directory.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(directory), prefix=f".{name}.", text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(payload, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, str(directory / name))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--quick", action="store_true", help="fast probe (default)")
    parser.add_argument("--full", action="store_true", help="also compute per-project totals")
    parser.add_argument("--root", default=None, help="override HOME (tests)")
    args = parser.parse_args()

    root = Path(args.root).expanduser() if args.root else Path.home()
    home = str(root)

    live, errors = scan_live(root, home)
    state_dir = (
        root / ".local" / "state" / "omarchy" / "agents-monitor"
        if args.root
        else Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
        / "omarchy" / "agents-monitor"
    )

    for provider in ("pi", "claude", "codex"):
        count = sum(1 for s in live["sessions"] if s["provider"] == provider)
        print(f"{provider}: {count} session(s) today, {errors.get(provider, 0)} parse error(s)")

    atomic_write(state_dir, "live.json", live)
    print(f"wrote {state_dir / 'live.json'}")

    if args.full:
        projects = scan_projects(root, home, live)
        atomic_write(state_dir, "projects.json", projects)
        print(f"wrote {state_dir / 'projects.json'}")


if __name__ == "__main__":
    sys.exit(main())
