#!/usr/bin/env python3
"""GitHub Copilot CLI usage collector for the Agents Monitor panel.

Prints (or, with --write, atomically writes) the record contract that
~/.local/state/omarchy/agents/usage/ consumers expect.

Store investigation (2026-09-13, copilot 1.0.83): ~/.copilot holds
session-state/*/events.jsonl (rich events - models, turns, hooks - but no
token counts; model metadata only), process logs (MCP noise), and the
real prize, session-store.db (SQLite, read with mode=ro so a running
Copilot is never blocked). Its schema is exactly what a token parser
wants - assistant_usage_events(input_tokens, output_tokens,
cache_read_tokens, cache_write_tokens, reasoning_tokens, model,
created_at) - but the table was EMPTY in that version: the CLI did not
persist usage yet.

Upgrade landed (2026-09-23, copilot 1.0.88): the table now has real
rows, caught live because the widget stopped picking up copilot at all
- it was never a bug, just this documented gap closing upstream. One
row per model call (not per turn: an agentic tool loop can call the
model several times inside turn_index 0), each carrying that call's own
usage - same shape as an Anthropic API response, so summing every row
is correct the same way summing every Claude Code transcript message
is correct (a growing cache_read_tokens across a session reflects a
genuinely growing conversation, not a cumulative-total quirk like
Codex's total_token_usage). One live wrinkle: 1.0.88 emits an exact
duplicate row for a small fraction of calls (same session, model, every
token field, same created_at, different `id`) - deduped below by
matching everything except the autoincrement id.

Token mapping: output <- output_tokens + reasoning_tokens (the
opencode/hermes convention: Copilot keeps thinking tokens separate from
output, both are generated), the rest direct. Copilot burns exactly one
subscription by definition (no compat-gateway routing here), so
subscriptionUsage/recentSubscriptionUsage bucket everything under its
own id "copilot" - the same synthesis claude/codex get from the panel,
done here directly since this collector owns its own record.

Prompt/session/activeDays counting is unchanged: turns with a non-empty
user_message, exactly as before the token upgrade - that is a real
"did I use this" signal independent of whether the usage table happens
to have rows for the same window. activeDays/activeDates are the union
of that and the usage-event days, so a call with no matching turn
timestamp still counts.
"""

import json
import os
import sqlite3
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

USAGE_DIR = Path(
    os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")
) / "omarchy" / "agents" / "usage"

DB_PATH = Path.home() / ".copilot" / "session-store.db"

USAGE_SQL = """
select id, session_id, model, input_tokens, output_tokens,
       reasoning_tokens, cache_read_tokens, cache_write_tokens, created_at
from assistant_usage_events
order by id
"""


def local_day(iso_utc):
    """Local calendar date for the db's ISO-8601 UTC text; None when
    unparseable (torn row mid-upgrade; WAL keeps committed rows whole)."""
    try:
        return datetime.fromisoformat(
            str(iso_utc).replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d")
    except (TypeError, ValueError, OSError):
        return None


def number(value):
    try:
        n = float(value)
        return max(0, round(n)) if n == n else 0
    except (TypeError, ValueError):
        return 0


def empty_bucket():
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def add_tokens(bucket, input_t, output_t, read_t, write_t):
    bucket["inputTokens"] += input_t
    bucket["outputTokens"] += output_t
    bucket["cacheReadInputTokens"] += read_t
    bucket["cacheCreationInputTokens"] += write_t


def scan():
    today = datetime.now().strftime("%Y-%m-%d")
    recent_dates = []
    for offset in range(6, -1, -1):
        recent_dates.append(
            datetime.fromordinal(datetime.now().toordinal() - offset).strftime("%Y-%m-%d")
        )
    recent = {d: {"date": d, "messageCount": 0} for d in recent_dates}

    active_days = set()
    sessions = set()
    today_sessions = set()
    total_prompts = 0
    today_prompts = 0

    usage_by_model = {}
    usage_by_recent_model = {}
    today_tokens_by_model = {}
    today_total_tokens = 0
    seen_events = set()

    connection = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True)
    try:
        rows = connection.execute(
            "select session_id, timestamp from turns"
            " where user_message is not null and user_message != ''"
        )
        for session_id, timestamp in rows:
            day = local_day(timestamp)
            if day is None:
                continue
            total_prompts += 1
            active_days.add(day)
            sessions.add(session_id)
            if day == today:
                today_prompts += 1
                today_sessions.add(session_id)

        for (event_id, session_id, model, input_raw, output_raw,
             reasoning_raw, read_raw, write_raw, created_at) in connection.execute(USAGE_SQL):
            # De-dup by everything except the autoincrement id: 1.0.88
            # emits exact-duplicate rows for a small fraction of calls.
            dedup_key = (session_id, model, input_raw, output_raw,
                         reasoning_raw, read_raw, write_raw, created_at)
            if dedup_key in seen_events:
                continue
            seen_events.add(dedup_key)

            input_t = number(input_raw)
            output_t = number(output_raw) + number(reasoning_raw)
            read_t = number(read_raw)
            write_t = number(write_raw)
            total = input_t + output_t + read_t + write_t
            if total <= 0:
                continue

            day = local_day(created_at)
            if day is None:
                continue
            model_name = str(model or "") or "unknown"

            active_days.add(day)
            add_tokens(usage_by_model.setdefault(model_name, empty_bucket()),
                       input_t, output_t, read_t, write_t)
            if day in recent:
                recent[day]["messageCount"] += total
                add_tokens(usage_by_recent_model.setdefault(model_name, empty_bucket()),
                           input_t, output_t, read_t, write_t)
            if day == today:
                today_total_tokens += total
                today_tokens_by_model[model_name] = today_tokens_by_model.get(model_name, 0) + total
    finally:
        connection.close()

    def subscription_bucket(by_model):
        bucket = empty_bucket()
        for model_bucket in by_model.values():
            add_tokens(bucket, model_bucket["inputTokens"], model_bucket["outputTokens"],
                       model_bucket["cacheReadInputTokens"], model_bucket["cacheCreationInputTokens"])
        return bucket

    subscription_usage = {"copilot": subscription_bucket(usage_by_model)} if usage_by_model else {}
    recent_subscription_usage = {"copilot": subscription_bucket(usage_by_recent_model)} if usage_by_recent_model else {}
    today_subscription_usage = {"copilot": today_total_tokens} if today_total_tokens > 0 else {}

    return {
        "schemaVersion": 1,
        "id": "copilot",
        "name": "Copilot",
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": total_prompts > 0,
        "tierLabel": "local stats",
        "limits": [],
        "usageStatusText": "",
        "authHelpText": "",
        "hasPromptStats": True,
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total_tokens,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [recent[d] for d in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": len(sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
        "modelUsage": usage_by_model,
        "recentModelUsage": usage_by_recent_model,
        "subscriptionUsage": subscription_usage,
        "recentSubscriptionUsage": recent_subscription_usage,
        "todaySubscriptionUsage": today_subscription_usage,
    }


def write_record(record):
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(USAGE_DIR), prefix=".copilot.", text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(record, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, str(USAGE_DIR / "copilot.json"))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main():
    if not DB_PATH.is_file():
        # Copilot never ran here: no store, no record, no tab. (A record
        # that existed before the store vanished stays as-is, like stock.)
        return 0
    record = scan()
    if "--write" in sys.argv[1:]:
        write_record(record)
        print(f"wrote {USAGE_DIR / 'copilot.json'}")
    else:
        json.dump(record, sys.stdout, indent=2)
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
