#!/usr/bin/env python3
"""pi agent usage collector for the Omarchy agents panel.

Prints (or, with --write, atomically writes) the record contract that
~/.local/state/omarchy/agents/usage/ consumers expect — the same contract
the stock omarchy-agent-usage-claude/codex/fireworks collectors emit. The
panel picks up any record that lands in that directory, so a pi tab appears
without touching the plugin.

What it counts (decision: complement of the stock collectors):
  pi sessions on the `anthropic` provider are folded into the Claude tab by
  omarchy-agent-usage-claude's scan_pi_usage(); sessions on `openai-codex`
  (provider or api) are folded into the Codex tab by
  omarchy-agent-usage-codex's scan_pi_sessions(). This collector counts
  everything ELSE — the providers no stock collector claims (currently zai,
  but any future provider lands here automatically rather than vanishing).

  Coupling note: if upstream ever widens those two filters, this exclusion
  list must widen with it or tokens get double-counted.

Local stats only: pi has no rate-limit endpoint the panel knows, so limits
stay empty and the tab shows tokens by day and by model.
"""

import json
import os
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

USAGE_DIR = Path(
    os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")
) / "omarchy" / "agents" / "usage"

SESSION_ROOTS = [
    Path.home() / ".pi" / "agent" / "sessions",
    Path.home() / ".omp" / "agent" / "sessions",
]

# Providers the stock collectors already claim from pi sessions (see
# docstring): exactly these, and nothing else, are excluded here.
CLAIMED_PROVIDERS = {"anthropic", "openai-codex"}
CLAIMED_API_PREFIXES = ("openai-codex",)


def local_day(value):
    """Local calendar date for an entry/message timestamp, like the stock
    collectors' local_day(): ISO strings (with Z), epoch seconds or
    milliseconds; falls back to today."""
    if value is None:
        return datetime.now().strftime("%Y-%m-%d")
    if isinstance(value, (int, float)):
        if value > 10_000_000_000:  # milliseconds
            value = value / 1000
        return datetime.fromtimestamp(value).strftime("%Y-%m-%d")
    text = str(value)
    try:
        if text.endswith("Z"):
            dt = datetime.fromisoformat(text[:-1] + "+00:00")
        else:
            dt = datetime.fromisoformat(text)
    except ValueError:
        return None
    if dt.tzinfo is not None:
        dt = dt.astimezone()
    return dt.strftime("%Y-%m-%d")


def number(value):
    try:
        n = float(value)
    except (TypeError, ValueError):
        return 0
    return int(n) if n > 0 else 0


def model_name(raw):
    return str(raw or "") or "unknown"


def is_claimed_by_stock(provider, api):
    if provider in CLAIMED_PROVIDERS:
        return True
    return any(api.startswith(p) for p in CLAIMED_API_PREFIXES)


def scan():
    today = datetime.now().strftime("%Y-%m-%d")
    recent_dates = []
    for offset in range(6, -1, -1):
        recent_dates.append(
            datetime.fromordinal(datetime.now().toordinal() - offset).strftime("%Y-%m-%d")
        )
    recent = {d: {"date": d, "messageCount": 0} for d in recent_dates}

    active_days = set()
    sessions = set()
    today_sessions = set()
    today_tokens = {}
    today_prompts = 0
    today_total = 0
    total_prompts = 0
    usage_by_model = {}

    for root in SESSION_ROOTS:
        if not root.is_dir():
            continue
        for path in sorted(root.rglob("*.jsonl")):
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    for line in fh:
                        line = line.strip()
                        if not line:
                            continue
                        try:
                            entry = json.loads(line)
                        except json.JSONDecodeError:
                            continue  # truncated line: session being written now
                        if not isinstance(entry, dict) or entry.get("type") != "message":
                            continue
                        message = entry.get("message") or {}
                        if message.get("role") != "assistant":
                            continue
                        provider = str(message.get("provider") or "")
                        api = str(message.get("api") or "")
                        if is_claimed_by_stock(provider, api):
                            continue
                        usage = message.get("usage") or {}
                        input_tokens = number(usage.get("input"))
                        output_tokens = number(usage.get("output"))
                        cache_read = number(usage.get("cacheRead"))
                        cache_write = number(usage.get("cacheWrite"))
                        total = number(usage.get("totalTokens"))
                        if total and not (input_tokens or output_tokens or cache_read or cache_write):
                            input_tokens = total
                        if not (input_tokens or output_tokens or cache_read or cache_write):
                            continue

                        day = local_day(entry.get("timestamp") or message.get("timestamp"))
                        model = model_name(message.get("model"))
                        sum_tokens = input_tokens + output_tokens + cache_read + cache_write

                        total_prompts += 1
                        sessions.add(str(path))
                        active_days.add(day)

                        bucket = usage_by_model.setdefault(model, {
                            "inputTokens": 0,
                            "outputTokens": 0,
                            "cacheReadInputTokens": 0,
                            "cacheCreationInputTokens": 0,
                        })
                        bucket["inputTokens"] += input_tokens
                        bucket["outputTokens"] += output_tokens
                        bucket["cacheReadInputTokens"] += cache_read
                        bucket["cacheCreationInputTokens"] += cache_write

                        if day in recent:
                            recent[day]["messageCount"] += sum_tokens
                        if day == today:
                            today_prompts += 1
                            today_sessions.add(str(path))
                            today_total += sum_tokens
                            today_tokens[model] = today_tokens.get(model, 0) + sum_tokens
            except OSError:
                continue

    return {
        "schemaVersion": 1,
        "id": "pi",
        "name": "Pi",
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": total_prompts > 0,
        "tierLabel": "local stats",
        "limits": [],
        "usageStatusText": "",
        "authHelpText": "",
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total,
        "todayTokensByModel": today_tokens,
        "recentDays": [recent[d] for d in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": len(sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(d for d in active_days if d),
        "modelUsage": usage_by_model,
    }


def write_record(record):
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(USAGE_DIR), prefix=".pi.", text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(record, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, str(USAGE_DIR / "pi.json"))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main():
    record = scan()
    if "--write" in sys.argv[1:]:
        write_record(record)
        print(f"wrote {USAGE_DIR / 'pi.json'}")
    else:
        json.dump(record, sys.stdout, indent=2)
        sys.stdout.write("\n")


if __name__ == "__main__":
    main()
