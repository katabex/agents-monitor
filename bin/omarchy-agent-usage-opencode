#!/usr/bin/env python3
"""OpenCode agent usage collector for the Agents Monitor panel.

Prints (or, with --write, atomically writes) the record contract that
~/.local/state/omarchy/agents/usage/ consumers expect — the same contract
the stock omarchy-agent-usage-claude/codex/fireworks collectors and the
bundled pi collector emit.

Source of truth is OpenCode's SQLite store,
~/.local/share/opencode/opencode.db (read-only access): the legacy
storage/ JSON tree is fully migrated into it (verified 2026-09-07: all 218
legacy message ids present in the db). Every assistant message with a
non-zero token count is counted — no exclusions. The stock Claude/Codex
collectors scan ~/.claude and ~/.codex and never touch OpenCode's db, so
unlike the pi collector there is no double-count coupling to track.

Token mapping into the Claude-shaped buckets the panel expects:
input ← tokens.input, output ← tokens.output + tokens.reasoning (OpenCode
splits reasoning out; Claude's output_tokens includes thinking),
cacheRead ← tokens.cache.read, cacheWrite ← tokens.cache.write. The sum
matches OpenCode's own tokens.total.

Local stats plus the z.ai GLM Coding Plan quota (OpenCode here runs on
that plan, so its subscription windows belong on this tab): the collector
probes the undocumented-but-community-standard
https://api.z.ai/api/monitor/usage/quota/limit with the coding-plan key
(auth.json → zai-coding-plan / zai, else $ZAI_API_KEY) and maps the rows
onto the panel's limit windows. The probe is fail-soft — 10 s timeout,
single attempt, last good payload cached in XDG_CACHE_HOME and reused while
its windows are still open — so local stats always survive a dead network.
Unknown row types (V3 points-based plans may send CREDIT_LIMIT and friends)
are skipped, never fatal. --quota-debug prints the raw payload to stderr.
"""

import json
import os
import sqlite3
import sys
import tempfile
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

USAGE_DIR = Path(
    os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")
) / "omarchy" / "agents" / "usage"

DB_PATH = Path.home() / ".local" / "share" / "opencode" / "opencode.db"

ZAI_QUOTA_URL = "https://api.z.ai/api/monitor/usage/quota/limit"
OPENCODE_AUTH_JSON = Path.home() / ".local" / "share" / "opencode" / "auth.json"
QUOTA_CACHE = Path(
    os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")
) / "omarchy" / "agent-usage" / "zai-quota.json"
QUOTA_TIMEOUT = 10.0
QUOTA_CACHE_MAX_AGE = 24 * 3600  # s; older caches describe a dead day

# --quota-debug prints this; scan() stash for main().
_LAST_RAW_PAYLOAD = {"payload": None, "source": ""}


def local_day(ms):
    """Local calendar date for epoch milliseconds; None when unparseable
    (the caller falls back to the row's time_created column)."""
    try:
        return datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d")
    except (TypeError, ValueError, OSError):
        return None


def number(value):
    try:
        n = float(value)
    except (TypeError, ValueError):
        return 0
    return int(n) if n > 0 else 0


def counted_tokens(tokens):
    """(input, output_incl_reasoning, cache_read, cache_write) for one
    assistant message's tokens object; all zeros means nothing to count.
    A message that only reports `total` still counts as that total."""
    tokens = tokens or {}
    cache = tokens.get("cache") or {}
    input_t = number(tokens.get("input"))
    output_t = number(tokens.get("output")) + number(tokens.get("reasoning"))
    read_t = number(cache.get("read"))
    write_t = number(cache.get("write"))
    if not (input_t or output_t or read_t or write_t):
        total = number(tokens.get("total"))
        if total:
            return total, 0, 0, 0
        return 0, 0, 0, 0
    return input_t, output_t, read_t, write_t


# ---------------------------------------------------------------- z.ai quota


def zai_api_key():
    """Coding-plan key: OpenCode's auth.json (zai-coding-plan first, then
    zai), else the environment. Empty string when nothing resolves."""
    if OPENCODE_AUTH_JSON.is_file():
        try:
            auth = json.loads(OPENCODE_AUTH_JSON.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            auth = {}
        for provider in ("zai-coding-plan", "zai"):
            entry = auth.get(provider) or {}
            for field in ("key", "access_token"):
                value = entry.get(field)
                if value:
                    return str(value)
    return os.environ.get("ZAI_API_KEY") or ""


def fraction(percent):
    """z.ai percentage (0-100) as the 0-1 fraction the panel meters want;
    None when the payload did not carry a usable number."""
    try:
        n = float(percent)
    except (TypeError, ValueError):
        return None
    if not (n >= 0):
        return None
    return min(1.0, n / 100.0)


def iso_reset(epoch_ms):
    """nextResetTime epoch-ms as ISO-8601 UTC; "" when unparseable."""
    try:
        return datetime.fromtimestamp(float(epoch_ms) / 1000, tz=timezone.utc).isoformat()
    except (TypeError, ValueError, OSError):
        return ""


# Window labels for the row types the endpoint has actually been observed
# to send. `unit` is a time-unit enum: 3 = hour, 6 = week, 5 = the
# search/zread tool quota (community docs call it monthly; the live reset
# has been seen landing much sooner — the countdown carries the truth, so
# the label asserts no period).
ZAI_ROW_LABELS = {
    ("TOKENS_LIMIT", 3): "Session (5-hour)",
    ("TOKENS_LIMIT", 6): "Weekly tokens",
    ("TIME_LIMIT", 5): "Tool requests",
}


def zai_limit_rows(payload):
    """(limit rows, level) mapped from a quota payload. Pure: no clock, no
    network. Unknown row types are skipped — V3 points-based plans may send
    CREDIT_LIMIT and other new shapes. Beware: `usage` is the cap,
    `currentValue` the consumption; only `percentage` is mapped."""
    data = payload.get("data") or {}
    rows = []
    for entry in data.get("limits") or []:
        label = ZAI_ROW_LABELS.get((entry.get("type"), entry.get("unit")))
        percent = fraction(entry.get("percentage"))
        if label is None or percent is None:
            continue
        rows.append({
            "label": label,
            "title": label,
            "percent": percent,
            "resetsAt": iso_reset(entry.get("nextResetTime")),
        })
    return rows, str(data.get("level") or "")


def window_open(resets_at, now):
    """Stock claude rule: a cached percentage outlives its probe only until
    its window rolls over — after that it describes a dead period. A row
    with no readable reset time is kept; a timestamp is no reason to throw
    away a real number."""
    if not resets_at:
        return True
    try:
        return datetime.fromisoformat(resets_at) > now
    except ValueError:
        return True


def short_quota_text(rows):
    """One status line, e.g. `5h 25% · wk 4% · tools 1% · resets 11:50`,
    reset time local like every other countdown the panel shows."""
    short = {"Session (5-hour)": "5h", "Weekly tokens": "wk", "Tool requests": "tools"}
    parts = []
    for row in rows:
        part = short.get(row["label"])
        if part:
            parts.append(f"{part} {int(round(row['percent'] * 100))}%")
    for row in rows:
        if row.get("resetsAt"):
            try:
                local = datetime.fromisoformat(row["resetsAt"]).astimezone()
                parts.append("resets " + local.strftime("%H:%M"))
            except ValueError:
                pass
            break
    return " · ".join(parts)


def fetch_zai_payload(key):
    request = urllib.request.Request(
        ZAI_QUOTA_URL,
        headers={"Authorization": "Bearer " + key, "Accept": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=QUOTA_TIMEOUT) as response:
        payload = json.loads(response.read().decode("utf-8"))
    if payload.get("code") != 200 or not isinstance(payload.get("data"), dict):
        raise ValueError("unexpected quota envelope")
    return payload


def read_cached_payload(now):
    try:
        cached = json.loads(QUOTA_CACHE.read_text(encoding="utf-8"))
        fetched = datetime.fromisoformat(cached.get("fetchedAt"))
        if (now - fetched).total_seconds() <= QUOTA_CACHE_MAX_AGE:
            payload = cached.get("payload")
            if isinstance(payload, dict):
                return payload
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        pass
    return None


def write_cached_payload(payload, now):
    try:
        QUOTA_CACHE.parent.mkdir(parents=True, exist_ok=True)
        QUOTA_CACHE.write_text(
            json.dumps({"fetchedAt": now.isoformat(), "payload": payload}),
            encoding="utf-8",
        )
    except OSError:
        pass  # cache is an optimization, never a requirement


def zai_quota(now):
    """(rows, level, status_text, help_text) for the record; never raises.
    Failures surface in authHelpText (the panel's urgent red box shows that,
    and the hero falls back to the tier label) — usageStatusText stays the
    informational line."""
    key = zai_api_key()
    payload = None
    source = ""
    if key:
        try:
            payload = fetch_zai_payload(key)
            source = "probe"
        except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
            payload = None
        if payload is not None:
            write_cached_payload(payload, now)
    if payload is None and key:
        payload = read_cached_payload(now)
        if payload is not None:
            source = "cache"
    _LAST_RAW_PAYLOAD["payload"] = payload
    _LAST_RAW_PAYLOAD["source"] = source

    if payload is None:
        hint = "z.ai quota unavailable (probe failed, no fresh cache)" if key \
            else "z.ai quota needs a key: auth.json or $ZAI_API_KEY"
        return [], "", "", hint
    rows, level = zai_limit_rows(payload)
    rows = [row for row in rows if window_open(row["resetsAt"], now)]
    text = short_quota_text(rows)
    return rows, level, text, ""


# ---------------------------------------------------------------- collection


def scan():
    today = datetime.now().strftime("%Y-%m-%d")
    recent_dates = []
    for offset in range(6, -1, -1):
        recent_dates.append(
            datetime.fromordinal(datetime.now().toordinal() - offset).strftime("%Y-%m-%d")
        )
    recent = {d: {"date": d, "messageCount": 0} for d in recent_dates}

    active_days = set()
    sessions = set()
    today_sessions = set()
    today_tokens = {}
    today_prompts = 0
    today_total = 0
    total_prompts = 0
    usage_by_model = {}

    if DB_PATH.is_file():
        # mode=ro never takes a write lock, so a running OpenCode (WAL
        # writer) is never blocked and we never create the db by accident.
        connection = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True)
        try:
            rows = connection.execute(
                "select session_id, data, time_created from message"
                " where json_extract(data, '$.role') = 'assistant'"
                " order by time_created"
            )
            for session_id, raw, time_created in rows:
                try:
                    data = json.loads(raw)
                except json.JSONDecodeError:
                    continue  # torn write mid-line; WAL keeps rows whole
                input_t, output_t, read_t, write_t = counted_tokens(data.get("tokens"))
                total = input_t + output_t + read_t + write_t
                if not total:
                    continue

                time_obj = data.get("time") or {}
                day = local_day(time_obj.get("created"))
                if day is None:
                    day = local_day(time_created)
                if day is None:
                    day = today

                model = str(data.get("modelID") or "") or "unknown"

                total_prompts += 1
                sessions.add(session_id)
                active_days.add(day)

                bucket = usage_by_model.setdefault(model, {
                    "inputTokens": 0,
                    "outputTokens": 0,
                    "cacheReadInputTokens": 0,
                    "cacheCreationInputTokens": 0,
                })
                bucket["inputTokens"] += input_t
                bucket["outputTokens"] += output_t
                bucket["cacheReadInputTokens"] += read_t
                bucket["cacheCreationInputTokens"] += write_t

                if day in recent:
                    recent[day]["messageCount"] += total
                if day == today:
                    today_prompts += 1
                    today_sessions.add(session_id)
                    today_total += total
                    today_tokens[model] = today_tokens.get(model, 0) + total
        finally:
            connection.close()

    now = datetime.now(timezone.utc)
    quota_rows, quota_level, quota_text, quota_help = zai_quota(now)
    return {
        "schemaVersion": 1,
        "id": "opencode",
        "name": "OpenCode",
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": total_prompts > 0,
        "tierLabel": ("GLM " + quota_level.capitalize()) if quota_level else "local stats",
        "limits": quota_rows,
        "usageStatusText": quota_text,
        "authHelpText": quota_help,
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total,
        "todayTokensByModel": today_tokens,
        "recentDays": [recent[d] for d in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": len(sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(d for d in active_days if d),
        "modelUsage": usage_by_model,
    }


def write_record(record):
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(USAGE_DIR), prefix=".opencode.", text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(record, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, str(USAGE_DIR / "opencode.json"))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main():
    record = scan()
    if "--quota-debug" in sys.argv[1:]:
        source = _LAST_RAW_PAYLOAD["source"] or "none"
        payload = _LAST_RAW_PAYLOAD["payload"]
        sys.stderr.write(f"z.ai quota payload (source: {source}):\n")
        if payload is None:
            sys.stderr.write("  (unavailable — probe failed and no fresh cache)\n")
        else:
            json.dump(payload, sys.stderr, indent=2)
            sys.stderr.write("\n")
    if "--write" in sys.argv[1:]:
        write_record(record)
        print(f"wrote {USAGE_DIR / 'opencode.json'}")
    else:
        json.dump(record, sys.stdout, indent=2)
        sys.stdout.write("\n")


if __name__ == "__main__":
    main()
