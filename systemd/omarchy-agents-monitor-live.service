[Unit]
Description=Agents Monitor live session scan (full)
# Writes ~/.local/state/omarchy/agents-monitor/{live,projects}.json for the
# ptr.agents-monitor panel. Provider-independent companion to
# omarchy-pi-usage.timer: keeps the live view fresh while the shell is down
# and per-project totals on a 5-minute cadence.

[Service]
Type=oneshot
ExecStart=%h/.config/omarchy/plugins/ptr.agents-monitor/bin/agents-monitor-live --full
