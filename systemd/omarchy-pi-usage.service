[Unit]
Description=pi agent usage collector for the Agents Monitor panel
# Keeps ~/.local/state/omarchy/agents/usage/pi.json fresh between panel
# refreshes (default 900 s) and while the shell is down. Runs the
# collector FROM THE INSTALLED PLUGIN: a machine-local predecessor unit
# pointed at ~/.local/bin/omarchy-agent-usage-pi, a September-6 build
# without subscription attribution, whose every-5-minute rewrite dropped
# subscriptionUsage from the record and made the agent card's PER
# SUBSCRIPTION section (and, since v0.8.4, the service strip's
# use-based ordering) flip-flop whenever it won the race against the
# panel's own refresh. install.sh deploys this unit over the old one
# (same name); uninstall.sh removes it.

[Service]
Type=oneshot
ExecStart=%h/.config/omarchy/plugins/ptr.agents-monitor/bin/omarchy-agent-usage-pi --write
